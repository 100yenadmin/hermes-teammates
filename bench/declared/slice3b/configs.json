{
  "B-native": {
    "model": {
      "provider": "zai",
      "default": "glm-5.3"
    },
    "auth": {
      "adopt_external_logins": false
    },
    "security": {
      "allow_lazy_installs": false
    },
    "agent": {
      "max_turns": 40,
      "api_max_retries": 1
    },
    "compression": {
      "enabled": true
    },
    "terminal": {
      "backend": "local"
    },
    "delegation": {
      "max_concurrent_children": 4,
      "oneshot_max_children": 4,
      "max_iterations": 250
    },
    "plugins": {
      "isolation": "in_process",
      "enabled": []
    }
  },
  "C": null
}
